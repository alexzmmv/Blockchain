# ==========================
# COMMON VARIABLES
# ==========================
# These are used by both Local and Sepolia environments.
# (Fill CONTRACT_ADDRESS and PERKS_ADDRESS *after* you deploy)
CONTRACT_ADDRESS=
PERKS_ADDRESS=

# Game configuration options
LEVEL_UP_FEE=0.001
KITTY_CONTRACT_ADDRESS=0x06012c8cf97BEaD5deAe237070F9587f8E7A266d
MOCK_KITTIES_ADDRESS=

# Optional tools
REPORT_GAS=false


# ==========================
# LOCAL DEPLOY
# ==========================
# Hardhat provides a local network by default (http://127.0.0.1:8545).
# No special API keys or private keys are required to deploy locally!


# ==========================
# SEPOLIA DEPLOY
# ==========================
# Your deployer wallet private key (DO NOT commit real keys!)
PRIVATE_KEY=your_private_key_here

# Network RPC URL for Sepolia (You can use Infura, Alchemy, or a public one)
SEPOLIA_RPC_URL=https://rpc.sepolia.ethpandaops.io

# Etherscan API key for contract verification
ETHERSCAN_API_KEY=your_etherscan_api_key


# ==========================
# MAINNET DEPLOY (Commented in Config)
# ==========================
# If you ever uncomment the 'mainnet' network in hardhat.config.ts
# you will need to provide a real Ethereum RPC URL here:
MAINNET_RPC_URL=https://mainnet.infura.io/v3/your_infura_project_id
